# Archived reference: GitHub Actions deployment requires an additional workflow token scope.
name: Deploy tactical board

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Configure Pages
        uses: actions/configure-pages@v5
      - name: Upload tactical board
        uses: actions/upload-pages-artifact@v4
        with:
          path: static/tactical_board
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
